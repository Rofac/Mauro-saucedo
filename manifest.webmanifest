{
  "id": "./?app=pedidos",
  "name": "MS Pedidos",
  "short_name": "MS Pedidos",
  "description": "Pedidos de WhatsApp, calendario, cuentas y gastos",
  "lang": "es-AR",
  "start_url": "./?app=pedidos",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1d2b3a",
  "theme_color": "#1d2b3a",
  "share_target": {
    "action": "./compartir", "method": "POST", "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "url": "url",
      "files": [{ "name": "archivos", "accept": ["image/*", "audio/*", ".opus", ".ogg", ".m4a", ".mp3", ".aac", ".jpg", ".jpeg", ".png", ".webp"] }] }
  },
  "icons": [
    { "src": "img/icono-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "img/icono-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "img/icono-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
